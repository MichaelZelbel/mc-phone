# /etc/mc-phone/config.env  (root, mode 0600). The installer writes this for you.
# Every line is read by both halves of the service. The API key is NOT here; it lives in
# /etc/mc-phone/credentials.env, which only the dialling worker reads.

# How the assistant introduces itself on the phone: "the AI assistant of <this>".
GODSPEED_PHONE_CALLER_NAME="Sam Example"

# Your own mobile number, international form. The only number a rehearsal may call,
# and the callback number the assistant gives out when asked.
GODSPEED_PHONE_OWN_NUMBER=+4917212345678

# Dates in an order ("Friday", "2026-10-03") are checked against today in this zone.
GODSPEED_PHONE_TIMEZONE=Europe/Berlin

# Written by `mc-phone setup agent` and the installer's number step.
GODSPEED_PHONE_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GODSPEED_PHONE_NUMBER_ID=phnum_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Guard rails. The service refuses the sixth call of a day; the agent hangs up at 180 seconds.
GODSPEED_PHONE_DAILY_LIMIT=5
GODSPEED_PHONE_MAX_SECONDS=180

# The language model behind the voice. gemini-2.5-flash is the one that was tested.
GODSPEED_PHONE_MODEL=gemini-2.5-flash
